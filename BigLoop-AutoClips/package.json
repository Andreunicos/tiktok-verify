{
  "name": "bigloop-autoclips",
  "version": "0.3.0",
  "description": "BigLoop AutoClips — transforma gravações longas em cortes curtos, legendados e prontos para redes sociais.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "BigLoop",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "test:e2e": "electron-vite build && node tests/e2e/app.e2e.mjs",
    "release:win": "electron-vite build && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "1.56",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "com.bigloop.autoclips",
    "productName": "BigLoop AutoClips",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "*.exe",
          "*.txt"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BigLoop-AutoClips-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BigLoop AutoClips"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Andreunicos",
        "repo": "tiktok-verify",
        "releaseType": "draft"
      }
    ]
  }
}
